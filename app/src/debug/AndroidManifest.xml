<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name="fm.corus.android.ReferralPreviewActivity" android:exported="true" />
        <!-- Local debug builds only: repeat the claim UX without changing an account. -->
        <activity-alias
            android:name="fm.corus.android.ClaimRewardPreview"
            android:targetActivity="fm.corus.android.ReferralPreviewActivity"
            android:exported="true"
            android:label="Preview Club claim">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
