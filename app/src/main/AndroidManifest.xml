<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Media playback foreground service so the lock-screen / notification
         controls (play/pause/next/scrubber) stay alive while the app is
         backgrounded. Required for the MediaSessionService below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Package visibility (Android 11+): the share sheet detects Instagram and
         WhatsApp via PackageManager.getPackageInfo(); without these <queries>
         entries that call always throws NameNotFoundException, so the Instagram
         Stories and WhatsApp buttons would silently never appear. -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.whatsapp" />
    </queries>

    <application
        android:name=".CorusApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Corus"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Corus"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: corus:// -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="corus" />
            </intent-filter>

            <!-- Universal link: https://corus.fm — only the paths the app handles
                 (see DeepLinkHandler.parseWebUrl). Other corus.fm paths (e.g. /privacy,
                 /terms) fall through to the browser instead of being captured here. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="corus.fm" />
                <data android:pathPrefix="/post/" />
                <data android:pathPrefix="/u/" />
            </intent-filter>
        </activity>

        <!-- TIDAL OAuth login (hosts the TIDAL web login, captures the
             corus://tidal-auth redirect for client-side playlist creation). -->
        <activity
            android:name=".ui.screens.auth.TidalLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Corus" />

        <!-- FCM Service -->
        <service
            android:name=".service.CorusFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Media playback service: hosts the MediaSession that backs the
             lock-screen / notification media controls. media3 starts this
             as a foreground service automatically when playback begins. -->
        <service
            android:name=".service.CorusPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- FileProvider for sharing images (Instagram Stories, etc.) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Notification channels are created in CorusApplication.onCreate() -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="corus_general" />

        <!-- Small icon used when the FCM SDK builds the notification itself
             (notification-payload message arriving while the app is backgrounded
             or killed). Without this, FCM falls back to the opaque launcher icon,
             which the status bar masks into a solid white square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_corus" />

    </application>

</manifest>
