<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="fm.corus.spotify.auth.xml" />
        <exclude domain="sharedpref" path="fm.corus.spotify.libraryauth.xml" />
        <!-- Reinstalls must not restore a previous installation's invite or attribution state. -->
        <exclude domain="sharedpref" path="corus_referrals_v1.xml" />
        <exclude domain="sharedpref" path="corus_referral_attribution.xml" />
        <exclude domain="sharedpref" path="appsflyer-data" />
        <exclude domain="sharedpref" path="appsflyer-purchase-data" />
        <exclude domain="database" path="afpurchases.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fm.corus.spotify.auth.xml" />
        <exclude domain="sharedpref" path="fm.corus.spotify.libraryauth.xml" />
        <!-- Reinstalls must not restore a previous installation's invite or attribution state. -->
        <exclude domain="sharedpref" path="corus_referrals_v1.xml" />
        <exclude domain="sharedpref" path="corus_referral_attribution.xml" />
        <exclude domain="sharedpref" path="appsflyer-data" />
        <exclude domain="sharedpref" path="appsflyer-purchase-data" />
        <exclude domain="database" path="afpurchases.db" />
    </device-transfer>
</data-extraction-rules>
