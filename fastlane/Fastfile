require "fileutils"
require "tmpdir"

default_platform(:android)

platform :android do
  desc "Build and upload a release to Google Play internal testing"
  lane :internal do |options|
    version_name = options[:version_name].to_s.strip
    notes_en = options[:notes_en].to_s.strip
    notes_pt = options[:notes_pt].to_s.strip
    json_key = ENV["SUPPLY_JSON_KEY"].to_s

    UI.user_error!("Pass version_name, for example version_name:1.5.2") if version_name.empty?
    UI.user_error!("Pass English release notes with notes_en:\"...\"") if notes_en.empty?
    UI.user_error!("Pass Portuguese release notes with notes_pt:\"...\"") if notes_pt.empty?
    UI.user_error!("Set SUPPLY_JSON_KEY to the Play service-account JSON file") if json_key.empty?
    UI.user_error!("SUPPLY_JSON_KEY does not point to a file: #{json_key}") unless File.file?(json_key)

    # Google Play version codes are global across tracks. Looking at every
    # standard track prevents a code collision with a newer staged release.
    version_codes = %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(
        package_name: "fm.corus.android",
        track: track,
        json_key: json_key
      )
    rescue StandardError => error
      UI.important("Could not read #{track}: #{error.message}")
      []
    end

    UI.user_error!("Could not retrieve any existing Google Play version codes") if version_codes.empty?
    version_code = version_codes.map(&:to_i).max + 1

    File.write(
      "version.properties",
      "VERSION_CODE=#{version_code}\nVERSION_NAME=#{version_name}\n"
    )

    gradle(
      task: "bundle",
      build_type: "Release",
      properties: {
        "versionCode" => version_code,
        "versionName" => version_name
      }
    )

    aab_path = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    UI.user_error!("Gradle did not produce an AAB") unless aab_path && File.file?(aab_path)

    Dir.mktmpdir("corus-play-metadata") do |metadata_path|
      { "en-US" => notes_en, "pt-BR" => notes_pt }.each do |locale, notes|
        changelog_dir = File.join(metadata_path, locale, "changelogs")
        FileUtils.mkdir_p(changelog_dir)
        File.write(File.join(changelog_dir, "#{version_code}.txt"), "#{notes}\n")
      end

      upload_to_play_store(
        package_name: "fm.corus.android",
        json_key: json_key,
        track: "internal",
        release_status: "completed",
        aab: aab_path,
        metadata_path: metadata_path,
        skip_upload_apk: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end

    UI.success("Uploaded Corus #{version_name} (#{version_code}) to internal testing")
  end

  desc "Promote one verified internal release to production"
  lane :production do |options|
    version_code = options[:version_code].to_s.strip
    json_key = ENV["SUPPLY_JSON_KEY"].to_s

    UI.user_error!("Pass the approved internal version_code") if version_code.empty?
    UI.user_error!("Set SUPPLY_JSON_KEY to the Play service-account JSON file") if json_key.empty?
    UI.user_error!("SUPPLY_JSON_KEY does not point to a file: #{json_key}") unless File.file?(json_key)

    internal_codes = google_play_track_version_codes(
      package_name: "fm.corus.android",
      track: "internal",
      json_key: json_key
    ).map(&:to_s)
    UI.user_error!("Version code #{version_code} is not the current internal release") unless internal_codes == [version_code]

    upload_to_play_store(
      package_name: "fm.corus.android",
      json_key: json_key,
      track: "internal",
      track_promote_to: "production",
      track_promote_release_status: "completed",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Promoted Corus version code #{version_code} from internal testing to production")
  end
end
